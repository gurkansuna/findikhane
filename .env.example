# iyzico panelindeki Sandbox veya Production API anahtarlarını buraya koyun.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=

# Sandbox: https://sandbox-api.iyzipay.com
# Production: https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# HTTPS ile yayınlanan, sondaki / olmadan açık alan adınız.
PUBLIC_BASE_URL=https://findikhane.com

PORT=8080

# PostgreSQL (docker-compose bu değerlerle "postgres" servisini de yapılandırır).
POSTGRES_DB=findikhane
POSTGRES_USER=findikhane
POSTGRES_PASSWORD=changeme

# Uygulamayı docker-compose DIŞINDA çalıştırıyorsanız (örn. yerel bir Postgres'e
# bağlanmak için) tam bağlantı dizesini burada geçersiz kılabilirsiniz.
# POSTGRES_CONNECTION_STRING=Host=localhost;Port=5432;Database=findikhane;Username=findikhane;Password=changeme
